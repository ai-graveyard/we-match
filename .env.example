# 复制为 .env 并按需填写。生产环境 SESSION_SECRET、APP_PORT 与邮件配置为必填。

# 宿主机对外映射端口（docker-compose.yml 用），生产必填。
# 服务器和别的项目共用，不能用默认的 3000，改成分配给 we-match 的实际端口。
APP_PORT=

# Session 签名密钥，生产必填，至少 32 字符：openssl rand -hex 32
SESSION_SECRET=

# 管理后台登录邮箱白名单，逗号分隔。生产必配；未配时仅开发环境放行
ADMIN_EMAILS=

# SQLite 文件路径，默认 ./data/we-match.db
# DATABASE_PATH=./data/we-match.db

# 邮件通道：log（验证码打日志，默认）或 resend（正式上线必须）
MAIL_PROVIDER=log

# MAIL_PROVIDER=resend 时必填
RESEND_API_KEY=
# 发信人，域名须已在 Resend 验证：MAIL_FROM="We Match <noreply@wematch.v2ai.org>"
MAIL_FROM=

# 内测模式：显式设为 1 时，所有验证码固定 888888。
# 不填或其他值一律关闭；没配 MAIL_PROVIDER=resend 时外部用户无法登录，但不会自动敞开账号。
#   BETA_MODE=1  明确打开，仅限测试账号
#   BETA_MODE=0  明确关闭（与不填相同）
# ⚠️ 开着就等于任何人可以登录成任何人。正式对外必须配好 Resend，并保持 BETA_MODE 非 1。
# BETA_MODE=

# P4 反滥用惩罚阶梯的执行模式：shadow（默认，只观测不降额）或 enforce（真正降额）。
#   shadow  ：命中惩罚阈值时不动用户额度，只写 quota_penalty_shadow 分析事件供观察。
#   enforce ：确认阈值稳妥后再开，命中即按 QUOTA.md 第 10 节降额。
# 不填即 shadow。正式放开惩罚前，请先在 shadow 模式下核对影子事件是否误伤真实用户。
# QUOTA_P4_MODE=shadow

# 对外站点 origin。生产环境建议固定配置，避免安装指令、邮件链接受 Host 头影响。
SITE_ORIGIN=https://wematch.v2ai.org

# 备份保留份数（scripts/backup-db.mjs），默认 14
# BACKUP_KEEP=14
