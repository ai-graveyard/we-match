# 复制为 .env 并按需填写。生产环境 SESSION_SECRET、APP_PORT 与邮件配置为必填。

# 宿主机对外映射端口（docker-compose.yml 用），生产必填。
# 服务器和别的项目共用，不能用默认的 3000，改成分配给 we-match 的实际端口。
APP_PORT=

# Session 签名密钥，生产必填，至少 32 字符：openssl rand -hex 32
SESSION_SECRET=

# 管理后台登录邮箱白名单，逗号分隔。生产必配；未配时仅开发环境放行
ADMIN_EMAILS=

# SQLite 文件路径，默认 ./data/we-match.db
# DATABASE_PATH=./data/we-match.db

# 邮件通道：log（验证码打日志，默认）或 resend（正式上线必须）
MAIL_PROVIDER=log

# MAIL_PROVIDER=resend 时必填
RESEND_API_KEY=
# 发信人，域名须已在 Resend 验证：MAIL_FROM="We Match <noreply@wematch.v2ai.org>"
MAIL_FROM=

# 内测模式：所有验证码固定 888888。
# 不填时自动判定——没配 MAIL_PROVIDER=resend 就认为还在内测（否则验证码只落日志，没人登得进来）。
#   BETA_MODE=1  强制打开（Resend 已配好，但仍想让内测用户用固定码）
#   BETA_MODE=0  强制关闭（宁可谁都登不进去，也不要敞着）
# ⚠️ 开着就等于任何人可以登录成任何人。正式对外前必须配好 Resend，或显式设 BETA_MODE=0。
# BETA_MODE=

# OG 图 / metadata 的站点 origin，默认按请求头推断，一般无需配置
# SITE_ORIGIN=https://wematch.v2ai.org

# 备份保留份数（scripts/backup-db.mjs），默认 14
# BACKUP_KEEP=14
